{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeVisor",
  "version": "1.0.0",
  "identifier": "com.vibevisor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VibeVisor",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws://127.0.0.1:* ws://localhost:*; frame-src 'none';",
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Capability for the main window",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:default",
            "fs:default",
            "opener:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecars/qemu/*": "sidecars/qemu/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "vibe.entitlements"
    },
    "shortDescription": "High-performance virtualization for Apple Silicon",
    "longDescription": "VibeVisor is a high-performance, memory-secure virtualization apparatus engineered for macOS on Apple Silicon. Built with Rust and Tauri for a professional, low-overhead experience.",
    "category": "DeveloperTool",
    "publisher": "VibeVisor"
  },
  "plugins": {}
}
